diff --git a/proto/telemetry/vehicle.proto b/proto/telemetry/vehicle.proto
--- a/proto/telemetry/vehicle.proto
+++ b/proto/telemetry/vehicle.proto
@@ -3,5 +3,5 @@
 message VehicleTelemetry {
   string vehicle_id = 1;
   // Ground speed in meters per second.
