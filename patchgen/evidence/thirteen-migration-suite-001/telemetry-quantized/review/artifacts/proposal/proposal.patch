diff --git a/proto/telemetry/vehicle.proto b/proto/telemetry/vehicle.proto
--- a/proto/telemetry/vehicle.proto
+++ b/proto/telemetry/vehicle.proto
@@ -2,6 +2,6 @@
 package simulation.telemetry;
 message VehicleTelemetry {
   string vehicle_id = 1;
-  // Ground speed in meters per second.
-  float speed_mps = 2;
+  // Ground speed truncated to integer meters per second.
+  int32 speed_mps = 2;
 }
diff --git a/runtimes/python/telemetry_runtime.py b/runtimes/python/telemetry_runtime.py
--- a/runtimes/python/telemetry_runtime.py
+++ b/runtimes/python/telemetry_runtime.py
@@ -7,7 +7,7 @@
 
 def evaluate(request):
     entity = VehicleTelemetry.FromString(base64.b64decode(request['payload'], validate=True))
-    sample = VehicleTelemetry(vehicle_id=request['vehicle_id'], speed_mps=request['speed'])
+    sample = VehicleTelemetry(vehicle_id=request['vehicle_id'], speed_mps=int(min(2_147_483_647, max(-2_147_483_648, request['speed']))))
     fields = {'vehicle_id': entity.vehicle_id, 'speed_mps': entity.speed_mps}
     return {'fields': fields, 'speeding': entity.speed_mps > 30.0,
